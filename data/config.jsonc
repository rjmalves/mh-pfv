{
    // Modo de execucao do modelo: train | predict    
    "mode": "train",

    // Caminho para a leitura dos dados de entrada 
    "input": "./data",

    // Caminho para a escrita dos dados de saida 
    "output": "./out",

    // Caminho para obtencao do artefato do modelo treinado 
    "artifact": "./artifact",

    // Janela de datas para calculo do melhor historico. Pode ser informada de duas formas:
    //     * um escalar inteiro, indicando numero de dias passados contados a partir da data de 
    //       execucao do programa
    //     * vetor de duas posicoes contendo datas como strings no padrao YYYY-MM-DD indicando data
    //       inicial e final da janela
    // "janela": ["2020-01-01", "2020-02-01"],
    "janela": 90,
    
    // Vetor dos ids de usinas a serem consideradas no processo; vazio usa todas 
    "ids_usinas": [],

    // Vetor de ids em ordem da prioridade das fontes de dados de geracao observada
    "ordem_prioridade_fontes": ["PI", "CCEE", "CCEE1h"],

    // Vetor de ids em ordem da prioridade dos modelos numericos de tempo
    "ordem_prioridade_modelosNWP": ["GFS"],

    // Fator de tolerancia para eliminacao de dados invalidos de geracao, multiplicado pela 
    // capacidade instalada da usina"
    "fator_tolerancia_limite_superior_geracao": 1.1
}